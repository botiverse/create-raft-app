{
  "id": "oauth-http-action-service",
  "name": "OAuth + HTTP Action Service",
  "kind": "oauth-http-action-service",
  "status": "v0",
  "appType": "http_api_with_login",
  "conversationRole": "tool_api",
  "capabilities": [
    "oauth.sign_in",
    "oauth.userinfo",
    "agent_login.callback",
    "local.agent_session",
    "manifest.discovery",
    "manifest.actions",
    "http.action.invoke",
    "public_action_envelope",
    "token_revoke_boundary"
  ],
  "negativeCapabilities": [
    "messages.read",
    "messages.send",
    "raw_raft_token_exposure",
    "agent_facing_payload",
    "custom_action_card"
  ],
  "authoritySources": [
    "registration",
    "grant",
    "scope",
    "review",
    "runtime-permission"
  ],
  "manifest": "manifest.example.json",
  "readme": "README.md"
}
