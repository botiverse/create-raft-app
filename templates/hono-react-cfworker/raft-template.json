{
  "id": "hono-react-cfworker",
  "name": "Hono React Cloudflare Worker",
  "kind": "hosted-dual-human-agent-app",
  "status": "v0",
  "appType": "hosted_dual_app",
  "conversationRole": "tool_api",
  "capabilities": [
    "oauth.sign_in",
    "oauth.userinfo",
    "agent_login.direct_callback",
    "agent_manifest.discovery",
    "local.session",
    "http_api.session_context",
    "static.auth_gate",
    "openapi.discovery",
    "cloudflare.worker",
    "cloudflare.d1",
    "cloudflare.r2",
    "cloudflare.queue"
  ],
  "negativeCapabilities": [
    "messages.read",
    "messages.send",
    "agent_event.ingest",
    "bot.sender",
    "raw_userinfo.expose",
    "token.expose",
    "custom_action_card"
  ],
  "authoritySources": [
    "registration",
    "grant",
    "scope",
    "review",
    "runtime-permission"
  ],
  "readme": "README.md"
}

