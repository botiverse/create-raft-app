{
  "name": "Hosted HTTP Action Service Demo",
  "description": "Manifest-declared HTTP action service with public action envelope responses.",
  "manifestVersion": "0.1",
  "appType": "http_api",
  "conversationRole": "tool_api",
  "actions": [
    {
      "name": "summarize",
      "method": "POST",
      "path": "/actions/summarize",
      "auth": {
        "type": "bearer",
        "description": "Bearer token issued by the service owner or Raft app registration flow."
      },
      "request": {
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        }
      },
      "response": {
        "envelope": "public_action_envelope"
      }
    }
  ],
  "unsupported": [
    "custom_action_card",
    "messages.read",
    "messages.send"
  ]
}
